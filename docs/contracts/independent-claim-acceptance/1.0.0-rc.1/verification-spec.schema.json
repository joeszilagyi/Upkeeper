{
  "type": "object",
  "properties": {
    "$schema": {
      "const": "./verification-spec.schema.json"
    },
    "specification_id": {
      "const": "upkeeper.icvaa"
    },
    "version": {
      "const": "1.0.0-rc.1"
    },
    "adoption_status": {
      "const": "UNADOPTED"
    },
    "artifact_role": {
      "const": "normative_specification_not_observed_evidence"
    },
    "contract_file": {
      "const": "CONTRACT.md"
    },
    "principle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "trust_warning": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "serialization": {
      "type": "object",
      "properties": {
        "encoding": {
          "const": "UTF-8"
        },
        "line_endings": {
          "const": "LF"
        },
        "duplicate_object_keys": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "unknown_authority_fields": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "nonfinite_numbers": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "max_record_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_nesting_depth": {
          "type": "integer",
          "minimum": 1
        },
        "max_array_items": {
          "type": "integer",
          "minimum": 1
        },
        "max_string_characters": {
          "type": "integer",
          "minimum": 1
        },
        "remote_schema_resolution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "format_validation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "required": [
        "encoding",
        "line_endings",
        "duplicate_object_keys",
        "unknown_authority_fields",
        "nonfinite_numbers",
        "max_record_bytes",
        "max_nesting_depth",
        "max_array_items",
        "max_string_characters",
        "remote_schema_resolution",
        "digest",
        "format_validation"
      ],
      "additionalProperties": false
    },
    "record_schema_file": {
      "const": "records.schema.json"
    },
    "required_semantic_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "record_types": {
      "type": "object",
      "minProperties": 8,
      "maxProperties": 8,
      "propertyNames": {
        "enum": [
          "adoption",
          "work_authorization",
          "obligation",
          "claim",
          "evidence",
          "decision",
          "grant",
          "receipt"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "additionalProperties": {
          "enum": [
            "string",
            "identifier",
            "artifact_ref",
            "repo_ref",
            "validation_ref",
            "nullable_artifact_ref",
            "integer",
            "boolean",
            "timestamp",
            "assurance",
            "facts",
            "action",
            "disposition",
            "receipt_outcome",
            "privacy",
            "observation_kind",
            "identifier_array",
            "requirement_array",
            "reason_array",
            "action_array"
          ]
        }
      }
    },
    "assurance_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384
      },
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true
    },
    "obligation_states": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384
      },
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true
    },
    "decision_states": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384
      },
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true
    },
    "receipt_states": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384
      },
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true
    },
    "conformance_states": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384
      },
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true
    },
    "normalized_decision_model": {
      "type": "object",
      "properties": {
        "input_domain": {
          "type": "object",
          "properties": {
            "tri_state_fields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "minItems": 11,
              "maxItems": 11,
              "uniqueItems": true
            },
            "tri_state_values": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true
            },
            "boolean_fields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "tri_state_fields",
            "tri_state_values",
            "boolean_fields"
          ],
          "additionalProperties": false
        },
        "missing_or_extra_fields": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "all_reasons_retained": {
          "const": true
        },
        "first_matching_rule_selects_displayed_disposition": {
          "const": true
        },
        "ordered_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
                "maxLength": 256
              },
              "condition": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "field": {
                        "enum": [
                          "request_active",
                          "adoption_valid",
                          "authority_integrity_valid",
                          "subject_binding_valid",
                          "evidence_authenticity_valid",
                          "inventory_complete",
                          "verified_violation",
                          "observation_complete",
                          "checker_completed",
                          "required_unknown",
                          "human_judgment_resolved",
                          "is_noop"
                        ]
                      },
                      "equals": {
                        "enum": [
                          "TRUE",
                          "FALSE",
                          "UNKNOWN",
                          true,
                          false
                        ]
                      }
                    },
                    "required": [
                      "field",
                      "equals"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "any_not_true": {
                        "type": "array",
                        "items": {
                          "enum": [
                            "request_active",
                            "adoption_valid",
                            "authority_integrity_valid",
                            "subject_binding_valid",
                            "evidence_authenticity_valid",
                            "inventory_complete",
                            "verified_violation",
                            "observation_complete",
                            "checker_completed",
                            "required_unknown",
                            "human_judgment_resolved",
                            "is_noop"
                          ]
                        },
                        "minItems": 1,
                        "maxItems": 20,
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "any_not_true"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "any_not_false": {
                        "type": "array",
                        "items": {
                          "enum": [
                            "request_active",
                            "adoption_valid",
                            "authority_integrity_valid",
                            "subject_binding_valid",
                            "evidence_authenticity_valid",
                            "inventory_complete",
                            "verified_violation",
                            "observation_complete",
                            "checker_completed",
                            "required_unknown",
                            "human_judgment_resolved",
                            "is_noop"
                          ]
                        },
                        "minItems": 1,
                        "maxItems": 20,
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "any_not_false"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "always": {
                        "const": true
                      }
                    },
                    "required": [
                      "always"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "result": {
                "enum": [
                  "CANCELLED",
                  "BLOCKED",
                  "REJECTED",
                  "REVIEW_REQUIRED",
                  "NO_CHANGE_VERIFIED",
                  "ACCEPTED"
                ]
              }
            },
            "required": [
              "id",
              "condition",
              "result"
            ],
            "additionalProperties": false
          },
          "minItems": 8,
          "maxItems": 8
        },
        "known_complete_positive_input": {
          "type": "object",
          "properties": {
            "request_active": {
              "enum": [
                "TRUE",
                "FALSE",
                "UNKNOWN"
              ]
            },
            "adoption_valid": {
              "enum": [
                "TRUE",
                "FALSE",
                "UNKNOWN"
              ]
            },
            "authority_integrity_valid": {
              "enum": [
                "TRUE",
                "FALSE",
                "UNKNOWN"
              ]
            },
            "subject_binding_valid": {
              "enum": [
                "TRUE",
                "FALSE",
                "UNKNOWN"
              ]
            },
            "evidence_authenticity_valid": {
              "enum": [
                "TRUE",
                "FALSE",
                "UNKNOWN"
              ]
            },
            "inventory_complete": {
              "enum": [
                "TRUE",
                "FALSE",
                "UNKNOWN"
              ]
            },
            "verified_violation": {
              "enum": [
                "TRUE",
                "FALSE",
                "UNKNOWN"
              ]
            },
            "observation_complete": {
              "enum": [
                "TRUE",
                "FALSE",
                "UNKNOWN"
              ]
            },
            "checker_completed": {
              "enum": [
                "TRUE",
                "FALSE",
                "UNKNOWN"
              ]
            },
            "required_unknown": {
              "enum": [
                "TRUE",
                "FALSE",
                "UNKNOWN"
              ]
            },
            "human_judgment_resolved": {
              "enum": [
                "TRUE",
                "FALSE",
                "UNKNOWN"
              ]
            },
            "is_noop": {
              "type": "boolean"
            }
          },
          "required": [
            "request_active",
            "adoption_valid",
            "authority_integrity_valid",
            "subject_binding_valid",
            "evidence_authenticity_valid",
            "inventory_complete",
            "verified_violation",
            "observation_complete",
            "checker_completed",
            "required_unknown",
            "human_judgment_resolved",
            "is_noop"
          ],
          "additionalProperties": false
        },
        "test_vectors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
                "maxLength": 256
              },
              "changes": {
                "type": "object",
                "propertyNames": {
                  "enum": [
                    "request_active",
                    "adoption_valid",
                    "authority_integrity_valid",
                    "subject_binding_valid",
                    "evidence_authenticity_valid",
                    "inventory_complete",
                    "verified_violation",
                    "observation_complete",
                    "checker_completed",
                    "required_unknown",
                    "human_judgment_resolved",
                    "is_noop"
                  ]
                },
                "additionalProperties": {
                  "enum": [
                    "TRUE",
                    "FALSE",
                    "UNKNOWN",
                    true,
                    false
                  ]
                }
              },
              "expected": {
                "enum": [
                  "CANCELLED",
                  "BLOCKED",
                  "REJECTED",
                  "REVIEW_REQUIRED",
                  "NO_CHANGE_VERIFIED",
                  "ACCEPTED"
                ]
              }
            },
            "required": [
              "id",
              "changes",
              "expected"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 4096
        }
      },
      "required": [
        "input_domain",
        "missing_or_extra_fields",
        "all_reasons_retained",
        "first_matching_rule_selects_displayed_disposition",
        "ordered_rules",
        "known_complete_positive_input",
        "test_vectors"
      ],
      "additionalProperties": false
    },
    "action_model": {
      "type": "object",
      "properties": {
        "all_actions_require": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true
        },
        "action_specific_requirements": {
          "type": "object",
          "properties": {
            "PUBLISH_PROPOSAL": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "minItems": 1,
              "maxItems": 30,
              "uniqueItems": true
            },
            "APPLY_ACCEPTED_PATCH": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "minItems": 1,
              "maxItems": 30,
              "uniqueItems": true
            },
            "MERGE_CANDIDATE": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "minItems": 1,
              "maxItems": 30,
              "uniqueItems": true
            },
            "RESOLVE_ISSUE": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "minItems": 1,
              "maxItems": 30,
              "uniqueItems": true
            },
            "LAUNCH_NEXT_TASK": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "minItems": 1,
              "maxItems": 30,
              "uniqueItems": true
            },
            "EXTERNAL_EFFECT": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "minItems": 1,
              "maxItems": 30,
              "uniqueItems": true
            }
          },
          "required": [
            "PUBLISH_PROPOSAL",
            "APPLY_ACCEPTED_PATCH",
            "MERGE_CANDIDATE",
            "RESOLVE_ISSUE",
            "LAUNCH_NEXT_TASK",
            "EXTERNAL_EFFECT"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "all_actions_require",
        "action_specific_requirements"
      ],
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ICV-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "contract_anchor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "issue_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "minItems": 0,
            "maxItems": 20,
            "uniqueItems": true
          },
          "case_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^AC-[0-9]{3}$"
            },
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "title",
          "contract_anchor",
          "issue_refs",
          "case_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 50,
      "maxItems": 50
    },
    "adversarial_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ICV-[0-9]{3}$"
            },
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "status": {
            "const": "SPECIFIED_NOT_EXECUTED"
          }
        },
        "required": [
          "id",
          "title",
          "requirements",
          "expected",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 62,
      "maxItems": 62
    }
  },
  "required": [
    "$schema",
    "specification_id",
    "version",
    "adoption_status",
    "artifact_role",
    "contract_file",
    "principle",
    "trust_warning",
    "serialization",
    "record_schema_file",
    "required_semantic_checks",
    "record_types",
    "assurance_classes",
    "obligation_states",
    "decision_states",
    "receipt_states",
    "conformance_states",
    "normalized_decision_model",
    "action_model",
    "requirements",
    "adversarial_cases"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:upkeeper:icvaa:specification:1.0.0-rc.1",
  "title": "Structure of the ICVAA verification specification"
}
