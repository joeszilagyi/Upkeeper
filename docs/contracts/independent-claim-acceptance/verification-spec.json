  "lifecycle_rules": [
    {"id": "L1", "rule": "unresolved_condition has no mutable resolved flag; its referenced creation remains historical"},
    {"id": "L2", "rule": "only an authenticated retained applicable condition_resolution changes the effective hold"},
    {
      "id": "L3",
      "rule": "EVIDENCE_SATISFIED resolves only its condition under applicable subject/version mapping; new subject evidence is not proof the old candidate passed"
    },
    {"id": "L4", "rule": "REQUIREMENT_CHANGED or REQUIREMENT_WITHDRAWN is not SATISFIED under the old version"},
    {"id": "L5", "rule": "timers, retry, queue state, new attempt ID and compaction cannot clear unresolved conditions"},
    {
      "id": "L6",
      "rule": "missing/rolled-back required checkpoint or custody blocks dependent readiness; initialization needs separate protected authorization"
    },
    {
      "id": "L7",
      "rule": "CONFIRMED effect plus unretained receipt stays a confirmed observation with custody failure; dependent continuation is blocked"
    },
    {"id": "L8", "rule": "OUTCOME_UNKNOWN prevents potentially duplicative retry until authoritative reconciliation"},
    {"id": "L9", "rule": "task-local hold may permit separately authorized independent work; shared-authority uncertainty blocks all dependants"}
  ],
