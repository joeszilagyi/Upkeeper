    {"id": "D2", "when": "context_invalid_or_unestablished", "outcome": "BLOCKED"},
    {"id": "D3", "when": "any_required_violation", "outcome": "REJECTED"},
    {"id": "D4", "when": "any_required_unknown", "outcome": "BLOCKED"},
    {"id": "D5", "when": "any_required_pending_review", "outcome": "REVIEW_REQUIRED"},
    {"id": "D6", "when": "complete_satisfied_or_validly_inapplicable_no_change", "outcome": "NO_CHANGE_VERIFIED"},
    {"id": "D7", "when": "complete_satisfied_or_validly_inapplicable_other", "outcome": "ACCEPTED"}
  ],
